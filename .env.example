# Copy to .env and fill in
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mojfrizer"
# Signs login cookies. Use a long random string (min 32 chars).
AUTH_SECRET=""
# Salons get <slug>.ROOT_DOMAIN subdomains.
ROOT_DOMAIN="mojfrizer.com"
# Public address, used in emails.
APP_URL="https://mojfrizer.com"
# Email sending (resend.com). Leave RESEND_API_KEY empty in dev: emails are only logged.
RESEND_API_KEY=""
MAIL_FROM="mojfrizer <podsetnik@mojfrizer.com>"
# A scheduler calls GET /api/cron/reminders every ~30 min with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
