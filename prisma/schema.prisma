// mojfrizer.com — one database for all salons.
// Every salon-owned table carries salonId; queries must always filter by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // salon owner / manager
  WORKER // hairdresser working in a salon
  CLIENT // customer
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Who created the booking: the customer online, or the salon on the customer's behalf.
// Urgent request lifecycle: the owner reviews it and either arranges a swap or declines.
enum UrgentRequestStatus {
  PENDING
  RESOLVED
  DECLINED
}

enum BookingSource {
  ONLINE
  SALON
}

// Global user (not salon-scoped). One account can be a client of many salons.
model User {
  id             String   @id @default(cuid())
  // Customers sign up with phone only; salon staff use email. At least one is set.
  email          String?  @unique
  // Null for accounts created through Google sign-in.
  passwordHash   String?
  // Google account id ("sub"), set on Google sign-in.
  googleId       String?  @unique
  // Set once the customer proved they own the email (link in a mail, or Google sign-in).
  emailVerifiedAt DateTime?
  name           String
  // Normalized to +381..., used as the customer's login.
  phone          String?  @unique
  role           Role     @default(CLIENT)
  // Salon the client lands on right after login.
  favoriteSalonId String?
  favoriteSalon   Salon?  @relation("FavoriteSalon", fields: [favoriteSalonId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  ownedSalons         Salon[]         @relation("SalonOwner")
  workerProfiles      WorkerProfile[]
  clientAppointments  Appointment[]   @relation("ClientAppointments")
  urgentRequests      UrgentRequest[]
  createdAppointments Appointment[]   @relation("CreatedAppointments")
  chatMessages        ChatMessage[]
  chatAsClient        ChatMessage[]   @relation("ChatClient")
  avatar              UserAvatar?
  emailTokens         EmailToken[]

  @@map("users")
}

model Salon {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // mojfrizer.com/s/{slug}
  description String?
  city        String
  address     String
  phone       String?
  // Calendar grid for booking slots, in minutes.
  slotStepMinutes Int  @default(15)
  // Customers can cancel or move a booking online until this many hours before it starts.
  cancelCutoffHours Int @default(2)
  isActive    Boolean  @default(true)
  ownerId     String
  owner       User     @relation("SalonOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())

  workingHours WorkingHours[]
  daysOff      SalonDayOff[]
  workers      WorkerProfile[]
  services     Service[]
  appointments Appointment[]
  chatMessages ChatMessage[]
  favoritedBy  User[]          @relation("FavoriteSalon")
  urgentRequests UrgentRequest[]
  clientNotes  SalonClientNote[]
  workerTimeOff WorkerTimeOff[]

  @@index([city])
  @@map("salons")
}

// Weekly opening hours. Several rows per day allow a lunch break.
model WorkingHours {
  id        String @id @default(cuid())
  salonId   String
  salon     Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 1 = Monday ... 7 = Sunday (ISO)
  opensAt   Int // minutes from midnight, e.g. 540 = 09:00
  closesAt  Int

  @@index([salonId, dayOfWeek])
  @@map("working_hours")
}

// Holidays, vacations and other closed days.
model SalonDayOff {
  id      String   @id @default(cuid())
  salonId String
  salon   Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  reason  String?

  @@unique([salonId, date])
  @@map("salon_days_off")
}

model WorkerProfile {
  id           String   @id @default(cuid())
  salonId      String
  salon        Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // Optional: a worker can exist without their own login.
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName  String
  specialities String[]
  isActive     Boolean  @default(true)

  appointments Appointment[]
  timeOff      WorkerTimeOff[]

  @@unique([salonId, userId])
  @@index([salonId])
  @@map("worker_profiles")
}

model Service {
  id              String  @id @default(cuid())
  salonId         String
  salon           Salon   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  category        String?
  price           Int // in para: 1500 RSD = 150000
  // Price when booked in the same visit as another service (null = same as price).
  comboPrice      Int?
  durationMinutes Int
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)

  appointments Appointment[]
  urgentRequests UrgentRequest[]

  @@index([salonId])
  @@map("services")
}

model Appointment {
  id        String            @id @default(cuid())
  salonId   String
  salon     Salon             @relation(fields: [salonId], references: [id], onDelete: Cascade)
  workerId  String
  worker    WorkerProfile     @relation(fields: [workerId], references: [id])
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id])
  // Null when the salon books for a customer without an account (phone / walk-in).
  clientId  String?
  client    User?             @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: SetNull)
  guestName  String?
  guestPhone String?
  source      BookingSource
  // Null for online bookings made by a guest without an account.
  createdById String?
  createdBy   User?           @relation("CreatedAppointments", fields: [createdById], references: [id], onDelete: SetNull)
  startTime DateTime          @db.Timestamptz(3)
  endTime   DateTime          @db.Timestamptz(3)
  status    AppointmentStatus @default(BOOKED)
  // Set when the email reminder has been sent, so it goes out only once.
  reminderSentAt DateTime?
  // Secret for the customer's "manage booking" link (cancel, move, add to calendar). Works for guests too.
  manageToken String @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  // Price snapshot at booking time, in para. Revenue is summed from this.
  price     Int
  note      String?
  createdAt DateTime          @default(now())
  urgentRequest UrgentRequest?

  @@index([salonId, workerId, startTime])
  @@index([salonId, startTime])
  @@index([clientId])
  @@map("appointments")
}

// A customer who needs a slot on a fully booked day asks the salon to find one,
// usually by swapping with an already booked customer.
model UrgentRequest {
  id            String              @id @default(cuid())
  salonId       String
  salon         Salon               @relation(fields: [salonId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service             @relation(fields: [serviceId], references: [id])
  clientId      String?
  client        User?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  guestName     String
  guestPhone    String
  date          DateTime            @db.Date
  reason        String
  status        UrgentRequestStatus @default(PENDING)
  // Appointment created for this customer when the owner arranged a swap.
  appointmentId String?             @unique
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())

  @@index([salonId, status, date])
  @@map("urgent_requests")
}

// One conversation per (salon, customer). The salon side is shared by owner and staff.
model ChatMessage {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  // The customer this conversation is with.
  clientId  String
  client    User     @relation("ChatClient", fields: [clientId], references: [id], onDelete: Cascade)
  // Who wrote it: the customer, or a salon staff member.
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  fromSalon Boolean
  text      String
  // Set when the other side opens the conversation.
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([salonId, clientId, createdAt])
  @@index([clientId, createdAt])
  @@map("chat_messages")
}

// Profile photo, stored in the database (small, downscaled in the browser) in its own table
// so that loading a user never loads the image.
model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt

  @@map("user_avatars")
}

// What a salon keeps about one of its customers. Customers are identified by clientKey:
// "p:" + last 8 phone digits (guests and accounts alike), or "u:" + user id when there is no phone.
model SalonClientNote {
  id        String   @id @default(cuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  clientKey String
  note      String?
  // Customer must phone the salon instead of booking online (e.g. repeated no-shows).
  blockedOnline Boolean @default(false)
  updatedAt DateTime @updatedAt

  @@unique([salonId, clientKey])
  @@map("salon_client_notes")
}

enum EmailTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// One-time links sent by email. Only a hash of the token is stored.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, kind, createdAt])
  @@map("email_tokens")
}

// One hairdresser unavailable for a while (vacation, sick leave, a longer break) while the salon stays open.
model WorkerTimeOff {
  id        String        @id @default(cuid())
  salonId   String
  salon     Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  workerId  String
  worker    WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  startTime DateTime      @db.Timestamptz(3)
  endTime   DateTime      @db.Timestamptz(3)
  reason    String?
  createdAt DateTime      @default(now())

  @@index([salonId, workerId, startTime])
  @@map("worker_time_off")
}
