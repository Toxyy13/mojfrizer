# Copy to .env and fill in
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mojfrizer"
# Signs login cookies. Use a long random string (min 32 chars).
AUTH_SECRET=""
# Salons get <slug>.ROOT_DOMAIN subdomains.
ROOT_DOMAIN="mojfrizer.com"
# Public address, used in emails.
APP_URL="https://mojfrizer.com"
# Email sending (resend.com). Leave RESEND_API_KEY empty in dev: emails are only logged.
RESEND_API_KEY=""
MAIL_FROM="mojfrizer <podsetnik@mojfrizer.com>"
# A scheduler calls GET /api/cron/reminders every ~30 min with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""
# "Continue with Google": OAuth client from console.cloud.google.com (see PLAN.md). The button
# is hidden while these are empty.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# AI assistant (console.anthropic.com). The chat button is hidden while this is empty.
ANTHROPIC_API_KEY=""
# Optional: model for the assistant (default claude-haiku-5-5; claude-opus-5-5 is smarter but ~40x pricier).
ASSISTANT_MODEL=""
# Seed (prisma/seed.ts) on the hosting: password for the first salon owner account (min 8 chars),
# optional email (default olgica@mojfrizer.com). Locally the password defaults to "promeni-me".
SEED_OWNER_PASSWORD=""
SEED_OWNER_EMAIL=""
# Platform developer account (the only one that creates salons, sees /razvoj). Created or promoted on every deploy
# when both are set; the password is never stored in the repo. Set it in the Vercel dashboard, not in chat.
# Contact shown on the "Dodaj svoj salon" page and in the legal pages (salons call or write to get an account).
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
SEED_DEVELOPER_EMAIL=""
SEED_DEVELOPER_PASSWORD=""
# Migrations on Vercel use this direct connection when set (Neon adds it automatically).
DATABASE_URL_UNPOOLED=""
# Error monitoring (sentry.io, free plan). Off while SENTRY_DSN is empty. Server side only, personal data is scrubbed.
SENTRY_DSN=""
# Optional: link to your Sentry project, shown in the /razvoj panel (e.g. https://your-org.sentry.io/issues/).
SENTRY_PROJECT_URL=""
